<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Grist Map (OSM + infos)</title>

  <!-- Grist Custom Widget API -->
  <script src="https://docs.getgrist.com/grist-plugin-api.js"></script>

  <!-- Leaflet -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
        crossorigin=""/>
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
          integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
          crossorigin=""></script>

  <style>
    html, body { height: 100%; margin: 0; }
    #wrap { height: 100%; display: flex; flex-direction: column; }
    #status { padding: 8px 10px; font: 13px/1.3 system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif; }
    #map { flex: 1; min-height: 320px; }
    .muted { color: #666; }
    .err { color: #a00; }
    .ok { color: #0a6; }
    .hint { color: #666; font-size: 12px; }
    a { color: inherit; }
  </style>
</head>

<body>
  <div id="wrap">
    <div id="status" class="muted">En attente des données Grist…</div>
    <div id="map"></div>
  </div>

  <script>
    const statusEl = document.getElementById('status');

    function setStatus(msg, cls) {
      statusEl.className = cls || 'muted';
      statusEl.innerHTML = msg;
    }

    // Minimal HTML escaping for safe rendering
    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, (c) => ({
        '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;'
      }[c]));
    }

    function toNumber(v) {
      if (v === null || v === undefined || v === '') return null;
      const n = Number(v);
      return Number.isFinite(n) ? n : null;
    }

    function isUrl(s) {
      try { new URL(s); return true; } catch { return false; }
    }

    function isEmail(s) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(s);
    }

    function formatValueForPopup(value) {
      const s = String(value).trim();
      if (!s) return null;

      // Make URLs clickable
      if (isUrl(s)) {
        const safe = escapeHtml(s);
        return `<a href="${safe}" target="_blank" rel="noopener noreferrer">${safe}</a>`;
      }

      // Make emails clickable
      if (isEmail(s)) {
        const safe = escapeHtml(s);
        return `<a href="mailto:${safe}">${safe}</a>`;
      }

      return escapeHtml(s);
    }

    // Init map
    const map = L.map('map', { zoomControl: true });

    // OSM tiles (standard)
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; OpenStreetMap contributors'
    }).addTo(map);

    const markersLayer = L.layerGroup().addTo(map);

    // Default view (France)
    map.setView([46.5, 2.5], 6);

    function clearMarkers() {
      markersLayer.clearLayers();
    }

    function renderMarkers(records) {
      clearMarkers();

      const bounds = [];
      let count = 0;

      for (const record of records || []) {
        // Apply Grist column mapping
        const r = grist.mapColumnNames(record);
        if (!r) continue;

        const lat = toNumber(r.Latitude);
        const lon = toNumber(r.Longitude);
        if (lat === null || lon === null) continue;

        // Label: prefer mapped Label, fallback to common names if present
        const label = (r.Label || r.Nom || r.Name || r.Titre || '').toString().trim();

        // Build popup rows
        const rows = [];

        function pushRow(key, rawValue) {
          if (rawValue === null || rawValue === undefined) return;
          const formatted = formatValueForPopup(rawValue);
          if (!formatted) return;
          rows.push(`
            <tr>
              <td style="padding:2px 10px 2px 0; color:#666; white-space:nowrap; vertical-align:top;">
                ${escapeHtml(key)}
              </td>
              <td style="padding:2px 0; vertical-align:top;">
                ${formatted}
              </td>
            </tr>
          `);
        }

        if (label) pushRow("Libellé", label);

        // Additional mapped columns (the user chooses which ones to map)
        pushRow("Info 1", r.Info1);
        pushRow("Info 2", r.Info2);
        pushRow("Info 3", r.Info3);
        pushRow("Info 4", r.Info4);
        pushRow("Info 5", r.Info5);
        pushRow("Info 6", r.Info6);

        // Coordinates always shown
        pushRow("Coord.", `${lat.toFixed(6)}, ${lon.toFixed(6)}`);

        const popup = `
          <div style="font:13px/1.35 system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif">
            <table style="border-collapse:collapse;">
              ${rows.join("") || `<tr><td class="muted">${escapeHtml(lat.toFixed(6))}, ${escapeHtml(lon.toFixed(6))}</td></tr>`}
            </table>
          </div>
        `;

        const marker = L.marker([lat, lon]).bindPopup(popup);
        marker.addTo(markersLayer);

        bounds.push([lat, lon]);
        count++;
      }

      if (count === 0) {
        setStatus(
          `Aucun point affichable (Latitude/Longitude manquantes ou non numériques).<div class="hint">Astuce : mappez vos colonnes vers <b>Latitude</b> et <b>Longitude</b> dans la configuration du widget.</div>`,
          "err"
        );
        return;
      }

      setStatus(
        `${count} point(s) affiché(s). <span class="hint">Mappez Info 1…6 pour enrichir les popups.</span>`,
        "muted"
      );

      if (bounds.length === 1) {
        map.setView(bounds[0], 14);
      } else {
        map.fitBounds(bounds, { padding: [20, 20] });
      }
    }

    // Tell Grist what columns we want the user to map
    grist.ready({
      columns: [
        { name: "Latitude",  title: "Latitude",  type: "Numeric", optional: false },
        { name: "Longitude", title: "Longitude", type: "Numeric", optional: false },
        { name: "Label",     title: "Libellé (optionnel)", type: "Text", optional: true },

        // Extra info fields (user can map any columns to these)
        { name: "Info1", title: "Info 1 (optionnel)", type: "Any", optional: true },
        { name: "Info2", title: "Info 2 (optionnel)", type: "Any", optional: true },
        { name: "Info3", title: "Info 3 (optionnel)", type: "Any", optional: true },
        { name: "Info4", title: "Info 4 (optionnel)", type: "Any", optional: true },
        { name: "Info5", title: "Info 5 (optionnel)", type: "Any", optional: true },
        { name: "Info6", title: "Info 6 (optionnel)", type: "Any", optional: true },
      ]
    });

    // Render based on records received from Grist
    grist.onRecords((records) => {
      setStatus("Données reçues, rendu de la carte…", "muted");
      renderMarkers(records);
    });

  </script>
</body>
</html>
